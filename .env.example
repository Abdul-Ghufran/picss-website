# Production origin used for canonical URLs, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=https://picss.net

# Destination for institutional enquiry submissions (JSON POST).
# Until this is set, /api/enquiry returns 503 and the contact form directs
# visitors to email info@picss.net directly. See docs/DEPLOYMENT.md.
PICSS_ENQUIRY_WEBHOOK=
